<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.colonymind.watch</string>
  <key>ProgramArguments</key><array>
    <string>/absolute/path/to/venv/bin/colonymind</string>
    <string>--instance</string><string>/absolute/path/to/instance</string>
    <string>watch</string><string>--once</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/absolute/path/to/instance/watch.log</string>
  <key>StandardErrorPath</key><string>/absolute/path/to/instance/watch.log</string>
</dict></plist>
